# CareerLens Configuration Template

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite:///./careerlens.db
# PostgreSQL alternative for Docker/Production:
# DATABASE_URL=postgresql+psycopg2://careerlens_user:<password>@localhost:5432/careerlens_db

# PostgreSQL Credentials (used by Docker Compose)
POSTGRES_USER=careerlens_user
POSTGRES_PASSWORD=
POSTGRES_DB=careerlens_db

# Security & CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://localhost"]

# Frontend API base URL (for Vite)
VITE_API_BASE_URL=http://localhost:8000/api
